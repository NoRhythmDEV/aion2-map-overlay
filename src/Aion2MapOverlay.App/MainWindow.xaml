<Window x:Class="Aion2MapOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion 2 Map Overlay — Verteron preview" Width="500" Height="780" MinWidth="460" MinHeight="520"
        Background="#111820" Foreground="#EDF2F6" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#253647"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF2F6"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Aion 2 Map Overlay" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Verteron · screen capture only" Foreground="#8FA8BD" Margin="0,5,0,14"/>
            <TextBlock Text="Display containing the game" Margin="0,0,0,5"/>
            <ComboBox x:Name="DisplayPicker" Margin="0,0,0,12"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartButton" Content="Start overlay" Click="Start_Click"/>
                <Button x:Name="StopButton" Content="Stop" IsEnabled="False" Click="Stop_Click"/>
                <Button Content="Test screenshot…" Click="Screenshot_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Ready. Choose categories, start, and return to Aion 2." TextWrapping="Wrap" Foreground="#8FA8BD" Margin="0,12,0,12"/>
            <TextBlock x:Name="ResourceUsageText" Text="CPU — · RAM —" Foreground="#B9D9EC" Margin="0,0,0,12"
                       ToolTip="This app only. CPU is a percentage of total logical CPU capacity, averaged over the last second. RAM is the current working set."/>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Icon size"/>
            <Slider x:Name="IconSize" Minimum="10" Maximum="36" Value="20" TickFrequency="2" Margin="0,5,0,10" ValueChanged="Appearance_Changed"/>
            <TextBlock Text="Opacity"/>
            <Slider x:Name="IconOpacity" Minimum="0.25" Maximum="1" Value="0.9" Margin="0,5,0,12" ValueChanged="Appearance_Changed"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="8" ToolTip="Search categories" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="All" Click="All_Click"/><Button Content="None" Click="None_Click"/>
                <Button Content="Gatherables" Click="Gatherables_Click"/><Button Content="Collectibles" Click="Collectibles_Click"/>
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="GroupsList" Grid.Row="4" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Padding="4,7">
                        <Grid Width="360">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="25" Height="25"/>
                            <StackPanel Grid.Column="1" Margin="7,0">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding TypeLabel}" Foreground="#8FA8BD" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#8FA8BD" VerticalAlignment="Center"/>
                        </Grid>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="5" Margin="0,14,0,0" FontSize="11" Foreground="#8FA8BD" TextWrapping="Wrap"
                   Text="Possible spawn locations, not live availability. The overlay is click-through and hides outside the Verteron map. Settings save beside the executable. Data: Questlog.gg / NCSOFT. Local test build."/>
    </Grid>
</Window>
